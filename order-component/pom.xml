<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>se.gradinit.riverexample</groupId>
    <artifactId>gradinit-river-example</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>order-component</artifactId>
  <name>order-component</name>

  <dependencies>
    <dependency>
      <groupId>se.gradinit.riverexample</groupId>
      <artifactId>order-api</artifactId>
    </dependency>
    <dependency>
      <groupId>se.gradinit.riverexample</groupId>
      <artifactId>customer-api</artifactId>
    </dependency>
    <dependency>
      <groupId>se.gradinit.riverexample</groupId>
      <artifactId>example-support</artifactId>
    </dependency>
    <dependency>
      <groupId>se.gradinit.river</groupId>
      <artifactId>platform-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>se.gradinit.river</groupId>
      <artifactId>jsk-platform</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>se.gradinit.riverexample:*</include>
                </includes>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>se.gradinit.riverexample.order.OrderRouterMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
