<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>se.gradinit.riverexample</groupId>
    <artifactId>gradinit-river-example</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>integration-tests</artifactId>
  <name>integration-tests</name>

  <dependencies>
    <dependency>
      <groupId>se.gradinit.riverexample</groupId>
      <artifactId>customer-component</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>se.gradinit.riverexample</groupId>
      <artifactId>order-component</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>se.gradinit.riverexample</groupId>
      <artifactId>client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>se.gradinit.river</groupId>
      <artifactId>platform-bootstrap</artifactId>
    </dependency>
    <dependency>
      <groupId>se.gradinit.river</groupId>
      <artifactId>platform-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>se.gradinit.river</groupId>
      <artifactId>jsk-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>se.gradinit.river</groupId>
      <artifactId>reggie</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-platform-jars</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>se.gradinit.river</groupId>
                  <artifactId>platform-bootstrap</artifactId>
                  <version>${gradinit.river.version}</version>
                  <destFileName>platform-bootstrap.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>se.gradinit.river</groupId>
                  <artifactId>platform-cli</artifactId>
                  <version>${gradinit.river.version}</version>
                  <destFileName>platform-cli.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/river-jars</outputDirectory>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
          <execution>
            <id>platform-classpath</id>
            <phase>package</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/platform-classpath.txt</outputFile>
              <includeGroupIds>se.gradinit.river</includeGroupIds>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
          <argLine>--patch-module java.rmi=${project.build.directory}/river-jvm/compat-rmi-activation.jar --add-exports java.rmi/java.rmi.activation=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <gradinit.river.version>${gradinit.river.version}</gradinit.river.version>
            <river.bootstrap.jar>${project.build.directory}/river-jars/platform-bootstrap.jar</river.bootstrap.jar>
            <river.cli.jar>${project.build.directory}/river-jars/platform-cli.jar</river.cli.jar>
            <river.compat.jar>${project.build.directory}/river-jvm/compat-rmi-activation.jar</river.compat.jar>
            <river.platform.classpath>${project.build.directory}/platform-classpath.txt</river.platform.classpath>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
