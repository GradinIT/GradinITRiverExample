<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>se.gradinit.riverexample</groupId>
    <artifactId>gradinit-river-example</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>integration-tests</artifactId>
  <name>integration-tests</name>

  <dependencies>
    <dependency>
      <groupId>se.gradinit.riverexample</groupId>
      <artifactId>customer-component</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>se.gradinit.riverexample</groupId>
      <artifactId>order-component</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>se.gradinit.riverexample</groupId>
      <artifactId>client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>unpack-river-dist</id>
            <phase>package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <arguments>
                <argument>${project.basedir}/../scripts/unpack-river-dist.sh</argument>
                <argument>${gradinit.river.version}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <forkedProcessTimeoutInSeconds>780</forkedProcessTimeoutInSeconds>
          <argLine>--patch-module java.rmi=${project.build.directory}/river-jvm/compat-rmi-activation.jar --add-exports java.rmi/java.rmi.activation=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <gradinit.river.version>${gradinit.river.version}</gradinit.river.version>
            <river.compat.jar>${project.build.directory}/river-jvm/compat-rmi-activation.jar</river.compat.jar>
            <river.dist.home.file>${project.build.directory}/river-dist-home.txt</river.dist.home.file>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
